#---------------------------------------------------------------------------------
# OpenBGI for Nintendo Switch Makefile
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITPRO)),)
  $(error "Please set DEVKITPRO in your environment, export DEVKITPRO=/c/devkitPro or /opt/devkitpro")
endif

# 交叉编译工具链定义
PREFIX  := aarch64-none-elf-
CC      := $(DEVKITPRO)/devkitA64/bin/$(PREFIX)gcc
CXX     := $(DEVKITPRO)/devkitA64/bin/$(PREFIX)g++
AR      := $(DEVKITPRO)/devkitA64/bin/$(PREFIX)ar
STRIP   := $(DEVKITPRO)/devkitA64/bin/$(PREFIX)strip

NACPTOOL := $(DEVKITPRO)/tools/bin/nacptool
ELF2NRO  := $(DEVKITPRO)/tools/bin/elf2nro

# 目标输出定义
APP_TITLE   := OpenBGI
APP_AUTHOR  := Cytlan / Switch Port
APP_VERSION := 1.0.0

BUILD_DIR   := build_switch
OUTPUT_DIR  := bin/switch
TARGET_ELF  := $(BUILD_DIR)/bgi.elf
TARGET_NACP := $(BUILD_DIR)/bgi.nacp
TARGET_NRO  := $(OUTPUT_DIR)/bgi.nro

# 编译参数
ARCH    := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
DEFINES := -D__SWITCH__ -D_GNU_SOURCE -DBGI_SWITCH -DBGI_HAVE_VORBISFILE

INCLUDES := -Iinc \
            -I$(DEVKITPRO)/libnx/include \
            -I$(DEVKITPRO)/portlibs/switch/include \
            -I$(DEVKITPRO)/portlibs/switch/include/SDL2 \
            -I$(DEVKITPRO)/portlibs/switch/include/freetype2

CFLAGS  := $(ARCH) -std=c99 -O2 -g -Wall -Wextra -Wno-unused-parameter \
           -Wno-format-truncation -Wno-format-overflow $(DEFINES) $(INCLUDES)

# 链接参数与库依赖
LIBPATHS := -L$(DEVKITPRO)/libnx/lib -L$(DEVKITPRO)/portlibs/switch/lib
SPECS    := -specs=$(DEVKITPRO)/libnx/switch.specs
LDFLAGS  := $(ARCH) $(SPECS) -g -pie $(LIBPATHS)

# Switch SDL2/OpenGL/音频等完整静态依赖链
LIBS := -lSDL2 -lEGL -lGLESv2 -lglapi -ldrm_nouveau \
        -lfreetype -lvorbisfile -lvorbis -logg -lz -lnx -lm -lpthread

# 源码清单
CORE_SRC := $(wildcard src/core/*.c)
ASM_SRC  := $(wildcard src/asm/*.c)
SCN_SRC  := $(wildcard src/scn/*.c)
BPC_SRC  := $(wildcard src/bpc/*.c)
VM_SRC   := $(wildcard src/vm/*.c)
WAIT_SRC := $(wildcard src/wait/*.c)
SYS_SRC  := $(wildcard src/sys/*.c) $(wildcard src/sys/install/*.c) $(wildcard src/sysobj/*.c)
GFX_SRC  := $(wildcard src/gfx/*.c) $(wildcard src/gfx/background/*.c) $(wildcard src/gfx/mgr/*.c) \
            $(wildcard src/gfx/particle/*.c) $(wildcard src/gfx/window/*.c) $(wildcard src/gfx/text/*.c)
SND_SRC  := $(wildcard src/snd/*.c) $(wildcard src/snd/bw/*.c) $(wildcard src/snd/wm/*.c)
DUMP_SRC := $(wildcard src/dump/*.c)
OS_SRC   := src/os/os_common.c $(wildcard src/os/switch/*.c)

SRC := $(CORE_SRC) $(ASM_SRC) $(SCN_SRC) $(BPC_SRC) $(VM_SRC) $(WAIT_SRC) $(SYS_SRC) \
       $(GFX_SRC) $(SND_SRC) $(DUMP_SRC) $(OS_SRC)

# 中间文件对象
OBJS := $(patsubst src/%.c,$(BUILD_DIR)/%.o,$(SRC))
DEPS := $(OBJS:.o=.d)

# RomFS 与图标探测
ROMFS_ARG := $(if $(wildcard romfs),--romfsdir=romfs,)
ICON_ARG  := $(if $(wildcard icon.png),--icon=icon.png,)

.PHONY: all clean nro

all: $(TARGET_NRO)

nro: $(TARGET_NRO)

$(TARGET_NRO): $(TARGET_ELF) $(TARGET_NACP) | $(OUTPUT_DIR)
	@echo "  ELF2NRO $@"
	$(ELF2NRO) $< $@ --nacp=$(TARGET_NACP) $(ICON_ARG) $(ROMFS_ARG)
	@echo "=== Switch Homebrew Built: $@ ==="

$(TARGET_NACP): | $(BUILD_DIR)
	@echo "  NACPTOOL $@"
	$(NACPTOOL) --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(TARGET_ELF): $(OBJS) | $(BUILD_DIR)
	@echo "  LINK $@"
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

$(BUILD_DIR)/%.o: src/%.c | $(BUILD_DIR) inc/bgi/msg.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(OUTPUT_DIR):
	@mkdir -p $(OUTPUT_DIR)

clean:
	@rm -rf $(BUILD_DIR) $(OUTPUT_DIR)
	@echo "Cleaned Switch build outputs."

-include $(DEPS)
